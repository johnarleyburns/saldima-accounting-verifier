{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saldima.dev/schemas/comparison.schema.json",
  "title": "Comparison Result",
  "description": "Output of runner/compare.py: the result of comparing an actual report/schedule against an approved expected one.",
  "type": "object",
  "required": ["scenario_id", "period", "status", "discrepancies"],
  "properties": {
    "scenario_id": { "type": "string" },
    "period": { "type": "string" },
    "status": { "type": "string", "enum": ["PASS", "FAIL"] },
    "discrepancies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["statement_type", "account_id", "expected", "actual", "difference"],
        "properties": {
          "statement_type": { "type": "string" },
          "account_id": { "type": "string" },
          "expected": { "type": "string" },
          "actual": { "type": "string" },
          "difference": { "type": "string" }
        }
      }
    }
  }
}
