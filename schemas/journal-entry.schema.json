{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://saldima.dev/schemas/journal-entry.schema.json",
  "title": "Journal Entry",
  "type": "object",
  "required": ["id", "date", "lines"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string" },
    "date": { "type": "string", "format": "date" },
    "memo": { "type": "string" },
    "source_event_id": { "type": "string" },
    "lines": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["account_id", "debit", "credit"],
        "additionalProperties": false,
        "properties": {
          "account_id": { "type": "string" },
          "debit": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
          "credit": { "type": "string", "pattern": "^[0-9]+\\.[0-9]{2}$" },
          "description": { "type": "string" }
        }
      }
    }
  }
}
